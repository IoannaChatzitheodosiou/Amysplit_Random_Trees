# Settings shared by the aws/*.sh scripts. Edit these before the first run.

# AWS region. Pick the one closest to you (e.g. eu-west-2 = London, us-east-1 = N. Virginia).
AWS_REGION="eu-west-2"

# AWS CLI profile to use (the name you gave `aws configure sso` / `aws configure`).
AWS_PROFILE="${AWS_PROFILE:-default}"

# S3 bucket for data, code and results. Bucket names are global across all of AWS,
# so setup.sh appends your account ID to keep this unique.
BUCKET_PREFIX="optosplit-analysis"

# Instance type. m7i.4xlarge = 16 vCPU, 64 GB RAM.
# 64 GB leaves room for the RandomForest search on ~800k particles.
INSTANCE_TYPE="m7i.4xlarge"

# Disk for the instance in GB. Holds the raw TIFFs (~7 GB) plus all intermediate TIFF outputs.
VOLUME_GB=150

# The machine always shuts itself down (and is deleted) after this many hours, even if something hangs.
MAX_HOURS=6

# Local folder with the raw data, and the prefix used in strain_names_and_paths.yaml.
LOCAL_DATA_ROOT="/Volumes/Untitled/Preps_Repeat_Machine_Learning"

# Name used for the IAM role / instance profile created by setup.sh.
ROLE_NAME="optosplit-ec2-role"
